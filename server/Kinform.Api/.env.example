# WildLens / Meta Model API. Server only; never put a key in EXPO_PUBLIC_.
MODEL_API_KEY=REPLACE-WITH-YOUR-META-KEY
META_VISION_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
# Confirm credit or your intended billing arrangement in the Meta dashboard.
META_CREDIT_CONFIRMED=false
META_ENABLE_PAID_REQUESTS=false
# The inherited Kinform OpenAI routes remain in demo mode.
AI_MODE=Demo
AI_ENABLE_PAID_REQUESTS=false
