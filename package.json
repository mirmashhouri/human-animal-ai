{
  "name": "wildlens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "start": "npm run start --workspace apps/mobile",
    "web": "npm run web --workspace apps/mobile",
    "typecheck": "npm run typecheck --workspace apps/mobile",
    "test": "node --test tests/*.test.mjs",
    "api": "dotnet run --project server/Kinform.Api",
    "api:test": "dotnet run --project server/Kinform.Tests",
    "web:build": "npm run web:build --workspace apps/mobile",
    "test:meta": "dotnet run --project server/WildLens.Tests",
    "evaluate": "node scripts/evaluate.mjs",
    "test:teaching": "dotnet run --project server/Teaching.Tests",
    "test:memory": "dotnet run --project server/Memory.Tests"
  },
  "devDependencies": {
    "agent-browser": "0.36.0"
  }
}
